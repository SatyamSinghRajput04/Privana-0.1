# ──────────────────────────────────────────────────────────
# Privana — Environment Variables Template
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file to version control.
# ──────────────────────────────────────────────────────────

# ── Supabase (Server Mode) ────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → API
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
FULLSTACK_PROJECT_REF=your_supabase_project_ref_here
FULLSTACK_RESTORE_API_URL=your_restore_api_url_here

# ── Google OAuth (Optional — Server Mode only) ────────────
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
VITE_GOOGLE_AUTH_PROXY=your_google_auth_proxy_url_here

# ──────────────────────────────────────────────────────────
# NOTE: Solo Mode works with ZERO environment variables.
# Only Server Mode requires Supabase credentials.
# ──────────────────────────────────────────────────────────
